<Window x:Class="SAE_2._01_Interface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Paramètres"
        Height="450"
        Width="800">

    <Grid Background="#EDEDED">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="8*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Button Content="🏠"
        Width="64"
        Height="46"
        Grid.Column="0"
        VerticalAlignment="Top"
        HorizontalAlignment="Left"
        Margin="23,20,0,0"
        Click="BtnHome_Click"
        Background="Transparent"
        BorderBrush="Transparent"
        FontSize="30" RenderTransformOrigin="-0.657,0.299"/>

        <Border Grid.Column="1" Margin="20" BorderBrush="Black" BorderThickness="2" Background="White">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="20">

                    <Grid Margin="0,0,0,20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Paramètres"
               FontSize="28"
               FontWeight="Bold"
               VerticalAlignment="Center"
               Grid.Column="0"/>

                        <Button Content="✕"
            Width="30"
            Height="30"
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Click="BtnClose_Click"
            Background="Transparent"
            BorderBrush="Transparent"
            FontSize="16"
            FontWeight="Bold"/>

                    </Grid>

                    <TextBlock Text="Affichage" FontWeight="Bold" FontSize="18" Margin="0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="20,10">

                        <TextBlock Text="Taille des icônes" Width="150" VerticalAlignment="Center"/>

                        <StackPanel>

                            <TextBlock Text="{Binding ElementName=SliderIcones, Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Center"/>

                            <Slider x:Name="SliderIcones" Width="200" Minimum="25" Maximum="200" Value="100"/>

                        </StackPanel>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="20,10">

                        <TextBlock Text="Taille des textes" Width="150" VerticalAlignment="Center"/>

                        <StackPanel>

                            <TextBlock Text="{Binding ElementName=SliderTextes, Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Center"/>

                            <Slider x:Name="SliderTextes" Width="200" Minimum="25" Maximum="200" Value="100"/>

                        </StackPanel>

                    </StackPanel>

                    <TextBlock Text="Correction des couleurs" Margin="20,20,0,10"/>

                    <ComboBox x:Name="CbCorrection" HorizontalAlignment="Left" Margin="20,0,0,10" Width="180" SelectedIndex="0">
                        <ComboBoxItem Content="Aucune"/>
                        <ComboBoxItem Content="Protanopie"/>
                        <ComboBoxItem Content="Deutéranopie"/>
                        <ComboBoxItem Content="Tritanopie"/>
                    </ComboBox>

                    <TextBlock Text="Thème" FontWeight="Bold" FontSize="18" Margin="0,20,0,10"/>

                    <TextBlock Text="Fond" Margin="10"/>

                    <WrapPanel Margin="20,0">

                        <Border Background="White" Width="35" Height="35" Margin="5"
        BorderBrush="LightGray" BorderThickness="1"
        MouseLeftButtonDown="ChoixFond_Click"/>

                        <Border Background="Black" Width="35" Height="35" Margin="5"
        BorderBrush="LightGray" BorderThickness="1"
        MouseLeftButtonDown="ChoixFond_Click"/>

                        <Border Background="LightSteelBlue" Width="35" Height="35" Margin="5"
        BorderBrush="LightGray" BorderThickness="1"
        MouseLeftButtonDown="ChoixFond_Click"/>

                        <Border Background="Honeydew" Width="35" Height="35" Margin="5"
        BorderBrush="LightGray" BorderThickness="1"
        MouseLeftButtonDown="ChoixFond_Click"/>

                    </WrapPanel>
                    <TextBlock Text="Cadre" Margin="10"/>

                    <WrapPanel Margin="20,0">

                        <Border Background="SteelBlue" Width="35" Height="35" Margin="5"
        BorderBrush="LightGray" BorderThickness="1"
        MouseLeftButtonDown="ChoixCadre_Click"/>

                        <Border Background="IndianRed" Width="35" Height="35" Margin="5"
        BorderBrush="LightGray" BorderThickness="1"
        MouseLeftButtonDown="ChoixCadre_Click"/>

                        <Border Background="MediumPurple" Width="35" Height="35" Margin="5"
        BorderBrush="LightGray" BorderThickness="1"
        MouseLeftButtonDown="ChoixCadre_Click"/>

                        <Border Background="SeaGreen" Width="35" Height="35" Margin="5"
        BorderBrush="LightGray" BorderThickness="1"
        MouseLeftButtonDown="ChoixCadre_Click"/>

                    </WrapPanel>

                    <TextBlock Text="Jetons" Margin="10"/>

                    <WrapPanel Margin="20,0">

                        <Border Width="40" Height="40" Margin="5"
        BorderBrush="LightGray" BorderThickness="1"
        MouseLeftButtonDown="ChoixJetons_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Fill="MistyRose"/>
                                <Rectangle Grid.Column="1" Fill="Plum"/>
                            </Grid>
                        </Border>

                        <Border Width="40" Height="40" Margin="5"
        BorderBrush="LightGray" BorderThickness="1"
        MouseLeftButtonDown="ChoixJetons_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Fill="LightSkyBlue"/>
                                <Rectangle Grid.Column="1" Fill="DarkSlateGray"/>
                            </Grid>
                        </Border>

                        <Border Width="40" Height="40" Margin="5"
        BorderBrush="LightGray" BorderThickness="1"
        MouseLeftButtonDown="ChoixJetons_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Fill="DarkSeaGreen"/>
                                <Rectangle Grid.Column="1" Fill="Goldenrod"/>
                            </Grid>
                        </Border>

                    </WrapPanel>

                    <TextBlock Text="Son" FontWeight="Bold" FontSize="18" Margin="0,20,0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="20,10">

                        <TextBlock Text="Son général" Width="150" VerticalAlignment="Center"/>

                        <StackPanel>

                            <TextBlock Text="{Binding ElementName=SliderSonGeneral, Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Center"/>

                            <Slider x:Name="SliderSonGeneral" Width="200" Minimum="0" Maximum="100" Value="100"/>

                        </StackPanel>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="20,10">

                        <TextBlock Text="Musique" Width="150" VerticalAlignment="Center"/>

                        <StackPanel>

                            <TextBlock Text="{Binding ElementName=SliderMusique, Path=Value, StringFormat={}{0:0}%}" 
                   HorizontalAlignment="Center"/>

                            <Slider x:Name="SliderMusique"
                Width="200"
                Minimum="0"
                Maximum="100"
                Value="100"/>

                        </StackPanel>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="20,10">

                        <TextBlock Text="Effets sonores" Width="150" VerticalAlignment="Center"/>

                        <StackPanel>

                            <TextBlock Text="{Binding ElementName=SliderEffets, Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Center"/>

                            <Slider x:Name="SliderEffets" Width="200" Minimum="0" Maximum="100" Value="100"/>

                        </StackPanel>

                    </StackPanel>

                    <Grid Margin="0,30,0,10">

                        <Button Content="Réinitialiser" Width="120" Height="35" HorizontalAlignment="Left" Click="BtnReset_Click"/>

                        <Button Content="Valider" Width="120" Height="35" HorizontalAlignment="Right" Click="BtnValider_Click"/>

                    </Grid>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</Window>